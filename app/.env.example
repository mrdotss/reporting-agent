# Every variable below is required. The set and its order are defined once, in
# `lib/env.ts` as `REQUIRED_ENV_VARS`, and `test/boundaries.static.test.ts`
# fails if this file and that array disagree.
#
# Placeholders only — copy to `.env` (git-ignored) and fill in. No real
# credential value belongs in this file.

# Postgres connection for users, sessions, connected subscriptions, templates
# and report runs.
DATABASE_URL=postgres://<user>:<password>@<host>:5432/reporting

# 32 bytes, base64, used to encrypt the Azure client secret at rest.
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=<generate: openssl rand -base64 32>

# Region for the AgentCore runtime, the artifact bucket and the history table.
# Example: us-east-1
AWS_REGION=<aws-region>

# The deployed AgentCore runtime. Read from the environment at call time and
# never hardcoded in source.
RPT_RUNTIME_ARN=arn:aws:bedrock-agentcore:<aws-region>:<account-id>:runtime/<runtime-id>

# Private S3 bucket holding snapshots, figure ledgers, verification results and
# the rendered .docx / .pdf.
RPT_ARTIFACT_BUCKET=<artifact-bucket-name>

# DynamoDB table for chat conversations and messages. Declared and validated by
# `lib/env.ts`; no module in this spec reads it — chat history is out of scope
# here. Example: rpt-chat-history
RPT_HISTORY_TABLE=<dynamodb-table-name>

# Fast, cheap Bedrock model used for AI conversation titles. Declared and
# validated but unused by this spec, for the same reason as the table above.
# Example: moonshotai.kimi-k2.5
RPT_TITLE_MODEL_ID=<bedrock-model-id>

# Bearer secret authorizing `POST /api/cron/tick`. That endpoint can claim and
# invoke runs, so this is its only protection — treat it as a credential.
# Generate with: openssl rand -hex 32
RPT_CRON_SECRET=<generate: openssl rand -hex 32>

# The app's own public origin, used to build the `progress_url` the agent posts
# its phase transitions back to. No trailing slash.
# Example: https://reporting.example.com
RPT_APP_BASE_URL=https://<app-host>

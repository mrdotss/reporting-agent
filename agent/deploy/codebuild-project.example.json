{
  "name": "reporting-agent-build",
  "description": "Build the ARM64 reporting-agent runtime image and push it to ECR",
  "source": {
    "type": "GITHUB",
    "location": "https://github.com/mrdotss/reporting-agent.git",
    "buildspec": "agent/buildspec.yml",
    "gitCloneDepth": 1,
    "reportBuildStatus": false
  },
  "sourceVersion": "main",
  "artifacts": {
    "type": "NO_ARTIFACTS"
  },
  "environment": {
    "type": "ARM_CONTAINER",
    "image": "aws/codebuild/amazonlinux2-aarch64-standard:3.0",
    "computeType": "BUILD_GENERAL1_LARGE",
    "privilegedMode": true
  },
  "serviceRole": "arn:aws:iam::<ACCOUNT_ID>:role/ReportingAgentCodeBuildRole",
  "logsConfig": {
    "cloudWatchLogs": {
      "status": "ENABLED",
      "groupName": "/aws/codebuild/reporting-agent-build"
    }
  },
  "timeoutInMinutes": 45
}
          "aggregations": [
            "Total",
            "Count",
            "Minimum",
            "Maximum"
          ],
          "scale": 0,
          "label": "NIC-level bytes",
          "interval_scoped": true
        },
        {
          "name": "Network Out Total",
          "unit": "bytes",
          "unit_family": "magnitude",
          "aggregations": [
            "Total",
            "Count",
            "Minimum",
            "Maximum"
          ],
          "scale": 0,
